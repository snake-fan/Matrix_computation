\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Gradient Stability Analysis.} The x-axis represents the eigenvalue gap $\delta $ (simulating degeneracy as $\delta \to 0$). The standard spectral method (Red/Ionescu) exhibits gradient explosion due to the singularity in the calculation of eigenvector derivatives. In contrast, both the Unified Framework (Green) and our Proposed SVD-Free Newton-Schulz method (Blue) maintain constant low error rates. Our method avoids eigendecomposition entirely, offering superior numerical robustness.}}{7}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:results_stability}{{1}{7}{\textbf {Gradient Stability Analysis.} The x-axis represents the eigenvalue gap $\delta $ (simulating degeneracy as $\delta \to 0$). The standard spectral method (Red/Ionescu) exhibits gradient explosion due to the singularity in the calculation of eigenvector derivatives. In contrast, both the Unified Framework (Green) and our Proposed SVD-Free Newton-Schulz method (Blue) maintain constant low error rates. Our method avoids eigendecomposition entirely, offering superior numerical robustness}{figure.caption.2}{}}
