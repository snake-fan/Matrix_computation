\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Visual comparison of the learned projection fields on the test grid. \textbf  {Left:} The OptNet layer learns a sharp linear boundary (red dashed line) that coincides almost perfectly with the ground truth constraint (blue line). The displacement vectors are strictly orthogonal to the boundary. \textbf  {Right:} The MLP baseline approximates the projection field but fails to capture the sharp "kink" at the constraint boundary $x_1+x_2=1$, resulting in a smoothed approximation that violates the strict geometric logic.}}{13}{figure.caption.9}\protected@file@percent }
\newlabel{fig:comparison}{{4}{13}{Visual comparison of the learned projection fields on the test grid. \textbf {Left:} The OptNet layer learns a sharp linear boundary (red dashed line) that coincides almost perfectly with the ground truth constraint (blue line). The displacement vectors are strictly orthogonal to the boundary. \textbf {Right:} The MLP baseline approximates the projection field but fails to capture the sharp "kink" at the constraint boundary $x_1+x_2=1$, resulting in a smoothed approximation that violates the strict geometric logic}{figure.caption.9}{}}
